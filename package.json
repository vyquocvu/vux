{
  "name": "vux",
  "description": "Blog built on Next.js + Cloudflare Workers (D1 + R2).",
  "version": "2.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development next dev",
    "build": "next build",
    "build:opennext": "node scripts/ci-build-probe.mjs && opennextjs-cloudflare build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate:local": "wrangler d1 execute vux --local --file=./seeds/schema.sql",
    "db:seed:local": "node --experimental-strip-types scripts/seed.ts",
    "db:migrate:remote": "wrangler d1 execute vux --remote --file=./seeds/schema.sql",
    "db:seed:remote": "node --experimental-strip-types scripts/seed.ts --remote",
    "db:verify:remote": "node --experimental-strip-types scripts/verify-remote.ts",
    "r2:upload:local": "wrangler r2 object put --preview vux-media",
    "upload:images": "bash scripts/upload-images.sh",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@types/nprogress": "^0.2.0",
    "@types/react-tag-input": "^6.6.1",
    "@types/react-toast-notifications": "^2.4.0",
    "dayjs": "^1.8.32",
    "iron-session": "^8.0.4",
    "next": "15.5.29",
    "nprogress": "^0.2.0",
    "react": "^19.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.0",
    "react-tag-input": "^6.8.1",
    "react-toast-notifications": "^2.4.0",
    "sass": "^1.56.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.29",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.4.5",
    "wrangler": "^4.157.0",
    "@cloudflare/workers-types": "^5.20240821.0"
  },
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "fast-xml-parser": "^5.7.0",
    "glob": "^14.0.3",
    "minimatch": "^11.0.4",
    "brace-expansion": "^5.0.12",
    "qs": "^6.16.1",
    "undici": "^7.30.1",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "postcss": "^8.5.32",
    "postcss-selector-parser": "^6.1.5",
    "nanoid": "^3.3.18",
    "js-yaml": "^4.3.2",
    "proxy-addr": "^2.0.8",
    "body-parser": "^2.4.0",
    "uuid": "^11.1.1"
  }
}