{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "es2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "webworker"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "paths": {
      "~components/*": ["components/*"],
      "~collections/*": ["collections/*"],
      "~utils/*": ["utils/*"]
    },
    "incremental": true,
    "types": ["@cloudflare/workers-types"],
    "plugins": [{ "name": "next" }]
  },
  "exclude": ["node_modules", ".next", ".open-next", "wrangler", "scripts", "seeds"],
  "include": [
    "next-env.d.ts",
    "cloudflare-env.d.ts",
    "**/*.ts",
    "**/*.tsx"
  ]
}
